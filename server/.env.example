PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
GITHUB_TOKEN=your_github_token_here
CLIENT_URL=http://localhost:5173
# Set NODE_ENV=production when deploying (requires CLIENT_URL, defaults TRUST_PROXY=1, strict auth rate limit)
NODE_ENV=development
# Reverse proxy hop count for Express trust proxy (defaults to 1 in production, 0 otherwise)
TRUST_PROXY=0
