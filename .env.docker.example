# Talent Match - Docker Compose Environment
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env

# Secret key for signing and verifying JWT tokens (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Optional: GitHub Personal Access Token for live GitHub metrics during profile seeding
GITHUB_TOKEN=your_github_token_here
